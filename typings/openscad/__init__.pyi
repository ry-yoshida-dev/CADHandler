# Partial stubs for the PythonSCAD C extension, covering only what cad_handler uses.

# Not exported at runtime: import it only under TYPE_CHECKING.
class PyOpenSCAD:
    def union(self, other: PyOpenSCAD, /) -> PyOpenSCAD: ...
    def difference(self, other: PyOpenSCAD, /) -> PyOpenSCAD: ...
    def intersection(self, other: PyOpenSCAD, /) -> PyOpenSCAD: ...
    def translate(self, vector: list[float], /) -> PyOpenSCAD: ...
    def rotate(self, angles: list[float], /) -> PyOpenSCAD: ...
    def scale(self, factors: list[float], /) -> PyOpenSCAD: ...
    def mirror(self, normal: list[float], /) -> PyOpenSCAD: ...
    def mesh(self) -> tuple[list[list[float]], list[list[int]]]: ...
    def export(self, file: str, /) -> None: ...

def cube(size: list[float], center: bool = ...) -> PyOpenSCAD: ...
def cylinder(*, r: float, h: float, center: bool = ..., fn: int = ...) -> PyOpenSCAD: ...
def sphere(*, r: float, fn: int = ...) -> PyOpenSCAD: ...
def polygon(points: list[list[float]], /) -> PyOpenSCAD: ...
def linear_extrude(obj: PyOpenSCAD, /, *, height: float) -> PyOpenSCAD: ...
